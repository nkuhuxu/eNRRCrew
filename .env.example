# The self-contained asset root contains models/, input/, and prompts/.
ENRRCREW_ASSET_ROOT=.
ENRRCREW_RUNTIME_ROOT=./runtime
ENRRCREW_KNOWLEDGE_ROOT=./knowledge
ENRRCREW_RAG_SERVICE_URL=http://127.0.0.1:8765
ENRRCREW_RAG_SERVICE_TOKEN=
ENRRCREW_ADMIN_TOKEN=
GRAPHRAG_API_KEY=
GRAPHRAG_BASE_URL=https://api.openai.com/v1
ENRRCREW_CHAT_MODEL=gpt-4o-mini
ENRRCREW_MANAGER_MODEL=gpt-4o
ENRRCREW_AGENT_MAX_ROUNDS=8
ENRRCREW_AGENT_TIMEOUT=180
ENRRCREW_SANDBOX_IMAGE=enrrcrew-csv-sandbox:local
ENRRCREW_SANDBOX_TIMEOUT=30
